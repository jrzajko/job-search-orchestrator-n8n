      "id": "n-score-filter",
      "name": "Filter: Score >= 4"
    },
    {
      "parameters": {
        "jsCode": "const rows = items.map(item => `\n  <h3>${item.json.title} — ${item.json.company}</h3>\n  <p>${item.json.location} | £${item.json.salary_max} | Score: ${item.json.fit_score}/5</p>\n  <p>${item.json.fit_reasoning}</p>\n  <p><a href=\"${item.json.url}\">View posting</a></p>\n  <hr/>\n`).join(\"\");\n\nreturn [{ json: { emailBody: rows, count: items.length } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
