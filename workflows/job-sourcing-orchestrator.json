    {
      "parameters": {
        "jsCode": "const targetKeywords = [\n  \"solutions consultant\", \"solution consultant\", \"solutions engineer\",\n  \"ai solutions engineer\", \"business automation\", \"enterprise csm\",\n  \"customer success manager\", \"presales consultant\", \"pre-sales consultant\",\n  \"adoption strategist\"\n];\n\nconst excludeKeywords = [\"junior\", \"graduate\", \"intern\", \"apprentice\"];\nconst salaryFloor = 75000;\n\nreturn items.filter(item => {\n  const title = (item.json.title || \"\").toLowerCase();\n  const location = (item.json.location || \"\").toLowerCase();\n  const salaryMax = Number(item.json.salary_max) || 0;\n\n  const matchesTarget = targetKeywords.some(kw => title.includes(kw));\n  const isExcluded = excludeKeywords.some(kw => title.includes(kw));\n  const meetsSalary = salaryMax >= salaryFloor;\n  const validLocation = location.includes(\"london\") || location.includes(\"remote\") || location.includes(\"uk\");\n\n  return matchesTarget && !isExcluded && meetsSalary && validLocation;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -208
      ],
      "id": "n-filter",
      "name": "Filter: Keyword + Salary + Location",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "= {\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 200,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Score this job posting's fit (1-5, 5=excellent) for this candidate: [CANDIDATE PROFILE: years of experience, past roles, location, target role titles, target company types, salary floor]. Respond with ONLY valid JSON, no other text: {\\\"score\\\": <1-5>, \\\"reasoning\\\": \\\"<one sentence>\\\"}. Job posting - Title: {{ $json.title }}. Company: {{ $json.company }}. Location: {{ $json.location }}. Salary: £{{ $json.salary_max }}. Description: {{ $json.description }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1648,
        -208
      ],
      "id": "n-score",
      "name": "Score Fit via Claude API",
      "credentials": {
        "anthropicApi": {
          "id": "REPLACE_ME",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.content[0].text;\nconst cleaned = raw.replace(/```json|```/g, \"\").trim();\nconst parsed = JSON.parse(cleaned);\n\nconst original = $('Filter: Keyword + Salary + Location').item.json;\n\nreturn {\n  external_id: original.external_id,\n  source: original.source,\n  title: original.title,\n  company: original.company,\n  location: original.location,\n  url: original.url,\n  salary_max: original.salary_max,\n  fit_score: parsed.score,\n  fit_reasoning: parsed.reasoning\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1856,
        -208
      ],
      "id": "n-parse",
      "name": "Parse Score + Merge Job Data"
    },
    {
      "parameters": {
        "jsCode": "return items.filter(item => item.json.fit_score >= 4);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2064,
        -208
