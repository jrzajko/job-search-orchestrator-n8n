{
  "name": "Source - Adzuna",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "searchTerm"
            },
            {
              "name": "location"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "adz-trigger",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "url": "https://api.adzuna.com/v1/api/jobs/gb/search/1",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "what_and",
              "value": "={{ $json.searchTerm }}"
            },
            {
              "name": "where",
              "value": "={{ $json.location }}"
            },
            {
              "name": "app_id",
              "value": "YOUR_ADZUNA_APP_ID"
            },
            {
              "name": "app_key",
              "value": "YOUR_ADZUNA_APP_KEY"
            },
            {
              "name": "results_per_page",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        0
      ],
      "id": "adz-http",
      "name": "HTTP Request",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        416,
        0
      ],
      "id": "adz-split",
      "name": "Split Out"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "title",
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "company",
              "value": "={{ $json.company.display_name }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "location",
              "value": "={{ $json.location.display_name }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "url",
              "value": "={{ $json.redirect_url }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "salary_min",
              "value": "={{ $json.salary_min }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "salary_max",
              "value": "={{ $json.salary_max }}",
              "type": "string"
            },
            {
              "id": "a7",
              "name": "source",
              "value": "adzuna",
              "type": "string"
            },
            {
              "id": "a8",
              "name": "external_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "a9",
              "name": "posted_date",
              "value": "={{ $json.created }}",
              "type": "string"
            },
            {
              "id": "a10",
              "name": "description",
              "value": "={{ $json.description }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        624,
        0
      ],
      "id": "adz-set",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "jsCode": "// Adzuna still failing after 5 retries (usually a 503).\n// Return no postings for this search so the other searches carry on.\nreturn [];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        208
      ],
      "id": "adz-skip",
      "name": "Skip Failed Search"
    },
    {
      "parameters": {
        "content": "⚠️ If Adzuna still fails after 5 retries (usually a 503),\nthis search returns nothing and the other searches carry on,\ninstead of the whole morning run failing.",
        "width": 420,
        "height": 180
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        160
      ],
      "id": "adz-note",
      "name": "Sticky Note"
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "Split Out",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip Failed Search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Out": {
      "main": [
        [
          {
            "node": "Edit Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
