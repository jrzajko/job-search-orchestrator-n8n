      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Job feedback</title><style>body{font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;max-width:520px;margin:48px auto;padding:0 16px;color:#222;line-height:1.5}button{font-size:16px;padding:10px 20px;border:0;border-radius:6px;background:#2f6fed;color:#fff;cursor:pointer}a{color:#2f6fed}</style></head><body><h2>{{ $(\"Normalise Link\").item.json.action === \"applied\" ? \"Mark as applied?\" : \"Mark as not interested?\" }}</h2><p><b>{{ ($json.title || \"\").replace(/</g, \"&lt;\") }}</b> at {{ ($json.company || \"\").replace(/</g, \"&lt;\") }}</p><p>{{ $(\"Normalise Link\").item.json.action === \"applied\" ? \"This also adds the role to your Notion Job Pipeline with Stage: Applied.\" : \"It will be recorded so it is not suggested again.\" }}</p><form method=\"POST\" action=\"job-feedback-confirm\"><input type=\"hidden\" name=\"source\" value=\"{{ $(\"Normalise Link\").item.json.source }}\"><input type=\"hidden\" name=\"external_id\" value=\"{{ $(\"Normalise Link\").item.json.external_id }}\"><input type=\"hidden\" name=\"action\" value=\"{{ $(\"Normalise Link\").item.json.action }}\"><input type=\"hidden\" name=\"token\" value=\"{{ $(\"Normalise Link\").item.json.token }}\"><button type=\"submit\">Confirm</button></form></body></html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      }
    },
