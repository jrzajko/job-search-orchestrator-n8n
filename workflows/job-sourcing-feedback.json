      "typeVersion": 2.2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $(\"Normalise Link\").item.json.token }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $(\"Normalise Link\").item.json.expected_token }}"
            },
            {
              "leftValue": "={{ [\"applied\", \"not_interested\"].includes($(\"Normalise Link\").item.json.action) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.external_id }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
