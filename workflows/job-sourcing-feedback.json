      "name": "Add to Notion Job Pipeline",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 3,
      "position": [
        1344,
        512
      ],
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "dataSourceId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_NOTION_DATA_SOURCE_ID"
        },
        "title": "={{ $json.company || \"Unknown company\" }}",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Role|rich_text",
              "textContent": "={{ $json.title }}"
            },
            {
              "key": "Application link|url",
              "urlValue": "={{ $json.url }}",
              "ignoreIfEmpty": true
            },
            {
              "key": "Stage|select",
              "selectValue": "Applied"
            },
            {
              "key": "Decision|select",
              "selectValue": "Pending"
            },
            {
              "key": "Salary range|rich_text",
              "textContent": "={{ $json.salary_max ? ($json.salary_min && $json.salary_min !== $json.salary_max ? \"£\" + Math.round($json.salary_min).toLocaleString(\"en-GB\") + \" – \" : \"\") + \"£\" + Math.round($json.salary_max).toLocaleString(\"en-GB\") : \"\" }}"
            },
            {
              "key": "Fit rationale|rich_text",
              "textContent": "={{ $json.fit_score ? \"Auto-score \" + $json.fit_score + \"/5: \" : \"\" }}{{ $json.fit_reasoning || \"\" }}"
            },
            {
              "key": "Last contact date|date",
              "date": "={{ $now.toISODate() }}",
              "includeTime": false
            }
          ]
        },
        "contentType": "markdown",
        "markdown": "=## Overview\n\n{{ $json.title }} at {{ $json.company }} ({{ $json.location }}). Added from the daily job digest on {{ $now.toFormat(\"d MMMM yyyy\") }}.\n\n## Job Description\n\n{{ ($json.description || \"\").slice(0, 1800) }}\n\n[View posting]({{ $json.url }})\n\n## Notes / Red Flags\n\n",
        "options": {}
      }
    },
